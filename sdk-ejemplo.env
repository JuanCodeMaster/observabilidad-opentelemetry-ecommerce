# Orientativo: confirmar soporte por SDK/lenguaje.
OTEL_SERVICE_NAME=checkout
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ecommerce,service.version=1.0.0,service.instance.id=INSTANCIA_UNICA,deployment.environment.name=production
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=https://GATEWAY_PRIVADO:4317
OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/otel/tls/ca.crt
OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/etc/otel/tls/client.crt
OTEL_EXPORTER_OTLP_CLIENT_KEY=/etc/otel/tls/client.key
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
# AWS: confirmar soporte; delta para instrumentos compatibles.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=DELTA
# Sampling pendiente del punto 4: definirlo antes de produccion.
# Logs: requiere bridge/appender; las variables no lo crean.
