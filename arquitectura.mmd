      BG -->|"pipeline traces"| JG
      BG -->|"pipelines metrics / logs"| EG
    end
    AG -->|"OTLP gRPC / mTLS"| RG
    EG --> CM["Cloud Monitoring (métricas)<br/>Cloud Logging (logs)"]
  end

  subgraph AWS["AWS / ECS"]
