    subgraph CG["OTel Collector Contrib · gateway<br/>(2 o más réplicas)"]
      RG["receiver: otlp (:4317)"]
      MG["processor: memory_limiter"]
      PG["processor: resource/common"]
      BG["processor: batch<br/>(una instancia por pipeline)"]
      JG["exporter: otlp_grpc/jaeger<br/>traces"]
      EG["exporter: googlecloud<br/>metrics + logs"]
